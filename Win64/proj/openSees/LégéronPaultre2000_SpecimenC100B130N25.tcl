	 algorithm NewtonLineSearch;
	 set ok [analyze [expr $NSteps/1]]
 }
 
 test EnergyIncr $currentTolerance $nIter0;
algorithm $algo $algoOptions;	
 
	set h [expr $h + 1 ]
